extends _layout.pug

block vars
  - var isHome = true
  - var title = 'Henrike Legner – Soprano'

block hero
  .hero
    .image
    .text: .text-wrap
      h1
        img(alt="Henrike" src="./svg/henrike1.svg" style="width:3.87em")
        br
        img(alt="Legner" src="./svg/legner1.svg" style="width:3.43em")
        br
        span.subtitle: img(alt="Soprano" src="./svg/soprano1.svg" style="width:4.81em")

      a.cd(href="/cd")
        img(alt="CD Cover" src="./images/cd.jpg" width=90 height=90)
        .body
          .tag Neu
          h2 Von der Liebe Zaubermacht
          p Henrike Legner, Sopran • Gerold Huber, Klavier
          p Nominiert für den Preis der Deutschen Schallplattenkritik

      p.quote: a(href="https://www.br.de/mediathek/podcast/klassik-aktuell/interview-mit-henrike-legner/2111493" target="_blank")
        | “Unbedingt reinhören!”
        span – BR Klassik Aktuell Podcast
      p.quote: a(href="https://www.sueddeutsche.de/muenchen/bayerische-theaterakademie-musikhochschule-muenchen-haendel-ariodante-kritik-1.5570915" target="_blank")
        | “Eine Verheißung fürs Barockfach.”
        span – Süddeutsche Zeitung
      p.quote: a(href="./images/fono-forum.pdf" target="_blank")
        | “Barockglänzend, sakralbrillant, mädchenhaft klar […]. Ein großes Talent.”
        span – Fono Forum
      p.quote: a(href="https://www.sueddeutsche.de/muenchen/achill-unter-den-maedchen-oper-kritik-prinzregententheater-wolfgang-andreas-schultz-1.5771375" target="_blank")
        | “Sie füllt ihre Koloratursopran-Partie mit großer Flexibilität und Virtuosität ganz lupenrein aus.”
        span – Süddeutsche Zeitung
